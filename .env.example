# Configuration for `docker compose up`.
#
#   cp .env.example .env
#   docker compose up
#
# Every value below has a working default baked into docker-compose.yml, so an
# empty .env — or no .env at all — brings the stack up. Copy it anyway: the file
# is where you change the password, the port and the dataset name, and having it
# present means you can see what those are without reading the compose file.
#
# THIS FILE IS NOT ingest/.env.example. That one configures the binaries running
# NATIVELY against ClickHouse Cloud — the hosted demo's arrangement — and holds a
# Cloud hostname, port 9440 and TLS. This one configures a local stack in Docker
# and never touches Cloud. docker-compose.yml sets the ClickHouse connection
# itself and deliberately does not read either file for it, so there is no
# arrangement of these two in which `docker compose up` writes into the graded
# service.

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------
# The image tag matches the version the hosted demo runs on Cloud (26.2), so a
# behaviour you see locally is at least the same server generation. It is not
# the same engine — Cloud substitutes SharedMergeTree for MergeTree, which
# changes deduplication and blocks projections on Replacing/Summing tables. See
# CLAUDE.md before drawing conclusions here about how something behaves there.
CH_IMAGE=clickhouse/clickhouse-server:26.2

CH_USER=sonyliv
CH_PASSWORD=hackathon

# A dedicated database, not `default`. Schema objects are unprefixed —
# events_raw, events_clean, content_dim — so `default` would put them next to
# whatever else lives there.
CH_DATABASE=sonyliv_demo

# Host ports for ClickHouse itself. Both bind to 127.0.0.1 in the compose file;
# these only change which local port they land on, for when 9000 or 8123 is
# already taken.
CH_NATIVE_PORT=9000
CH_HTTP_PORT=8123

# ---------------------------------------------------------------------------
# The dashboard
# ---------------------------------------------------------------------------
# http://localhost:8088 once the stack is up.
DASHBOARD_PORT=8088

# Bearer token for the ingest API. Empty means unauthenticated, which is the
# right default here: the API has no host port at all, so it is reachable only
# from inside the compose network.
API_TOKEN=

# ---------------------------------------------------------------------------
# Loading the extracts
# ---------------------------------------------------------------------------
# Put the supplied CSVs in this directory and they are loaded on first `up`:
#
#     ch-hackathon-content-data.csv          the catalogue, ~1.4 MB
#     ch-hackathon-raw-data.csv              the events, ~1.8 GB
#
# The unseen day's files work unchanged — the loader globs the prefix, so
# *_surprise.csv is picked up with no config change.
#
# Neither is required. With no CSVs the stack comes up empty and the simulator
# is the data source, which is a working demo of exactly the thing being
# demonstrated: a curve that builds from a live stream.
DATA_DIR=./data

# The load is skipped when events_raw already holds rows, so restarting the
# stack does not re-parse 1.8 GB. Set to 1 to load anyway.
#
# Read that as the warning it is: the loader's dedup token makes a RETRY of the
# same batch a no-op, but loading a DIFFERENT file into a populated table is
# additive. Two days of events in one table is not an error anything will catch.
FORCE_LOAD=0

# ---------------------------------------------------------------------------
# Optional profiles
# ---------------------------------------------------------------------------
#   docker compose --profile traffic up     start a fleet immediately
#   docker compose --profile mcp up         serve the MCP tools over HTTP

# How much traffic the `traffic` profile starts, and for how long.
TRAFFIC_SESSIONS=250
TRAFFIC_MINUTES=30

# Bearer token for the MCP HTTP transport. It hands out SQL access, so the
# server refuses to start without one; the compose default is fine on loopback.
MCP_TOKEN=local-mcp-token
MCP_PORT=8848
