# systemd unit for the event-ingest API.
#
# Install once, by hand, as root:
#
#   sudo cp deploy/sonyliv-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable sonyliv-api
#
# deploy.sh restarts this unit but never installs or edits it: a unit file is a
# root-owned, security-relevant artifact and changing it deserves to be a
# deliberate, auditable act rather than a side effect of shipping a binary.
#
# Note the service will not start until sonyliv-api exists. Until then deploy.sh
# detects the missing unit and skips the restart.

[Unit]
Description=SonyLIV event ingest API
Documentation=https://github.com/ishantd/sonyliv-clickathon-2026
# Wants= rather than Requires=: the API should start and report unhealthy if the
# network is slow to come up, not refuse to start and need manual intervention.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Dedicated unprivileged account. Create it once with:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin sonyliv
User=sonyliv
Group=sonyliv

# ClickHouse credentials and tunables. Provisioned out of band, mode 0600, owned
# by sonyliv -- deploy.sh never writes this file, so no CH secret ever passes
# through the deploy path. See README.md.
EnvironmentFile=/etc/sonyliv/sonyliv.env

# All configuration comes from the environment file so tuning listen address,
# batch size or worker count needs a `systemctl restart`, not a redeploy.
ExecStart=/usr/local/bin/sonyliv-api

Restart=always
RestartSec=2
# Give up if it crashes 5 times in 60s. Without this a binary that dies on
# startup restarts forever and buries the real error in log noise.
StartLimitIntervalSec=60
StartLimitBurst=5

# SIGTERM lets the API finish in-flight inserts. wait_for_async_insert=1 means a
# request can be blocked on a server-side flush, so allow time to drain rather
# than killing mid-insert.
KillSignal=SIGTERM
TimeoutStopSec=30

# --- hardening -------------------------------------------------------------
# The process needs outbound TCP to ClickHouse and nothing else on this box.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ProtectSystem=strict makes everything read-only; nothing here needs to write to
# disk. Add ReadWritePaths= only if that changes.

[Install]
WantedBy=multi-user.target
