# Template for /etc/sonyliv/librechat.env on the box.
#
#   sudo install -m 600 -o root -g root /dev/null /etc/sonyliv/librechat.env
#   sudo vi /etc/sonyliv/librechat.env      # paste and fill this in
#
# Root-owned 0600, same convention as sonyliv.env and mcp.env: deploy-librechat.sh never
# writes it, so no secret travels through the deploy path. Docker reads it as root when it
# starts the containers.
#
# Generate the four crypto values with:
#   CREDS_KEY:           openssl rand -hex 32
#   CREDS_IV:            openssl rand -hex 16
#   JWT_SECRET:          openssl rand -hex 32
#   JWT_REFRESH_SECRET:  openssl rand -hex 32
#   LITELLM_MASTER_KEY:  echo "sk-$(openssl rand -hex 24)"
# LibreChat refuses to start on the defaults it ships, which is the correct behaviour --
# those values are public.

# --- the model, via LiteLLM -------------------------------------------------
GEMINI_API_KEY=

# LiteLLM's own auth. LibreChat presents this as its apiKey; nothing else may call the
# proxy. Must start with sk-.
LITELLM_MASTER_KEY=

# --- Langfuse Cloud ---------------------------------------------------------
# Read by BOTH containers, and they trace different halves:
#
#   LibreChat  emits an `AgentRun` trace per user turn -- the LangGraph structure, and a
#              TOOL span per MCP call carrying its arguments and its output. This is
#              native in v0.8.7; it needs no config beyond these three variables.
#   LiteLLM    emits a generation per model call with token counts and cost, which the
#              LibreChat spans do not carry.
#
# Two traces per turn, deliberately: neither is a superset of the other. To keep only
# LibreChat's, drop success_callback/failure_callback from litellm-config.yaml.
#
# LANGFUSE_HOST is what the SDKs call LANGFUSE_BASE_URL in the repo .env -- same value,
# different variable name, and getting it wrong silently sends traces to
# cloud.langfuse.com instead of erroring.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- the serving layer ------------------------------------------------------
# Same value as SONYLIV_MCP_TOKEN in /etc/sonyliv/mcp.env. LibreChat sends it as the bearer
# on every MCP call; if the two drift, every tool call returns 401 and the model reports
# that it has no data rather than that it is unauthorised.
SONYLIV_MCP_TOKEN=

# --- LibreChat crypto -------------------------------------------------------
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- LibreChat behaviour ----------------------------------------------------
# Both must be the public https origin, or OAuth-less login still works but absolute links
# in the UI point at localhost.
DOMAIN_CLIENT=https://your-host
DOMAIN_SERVER=https://your-host

# Open the door only long enough to create the demo account, then set this to false and
# `docker compose up -d api`. This is internet-facing.
ALLOW_REGISTRATION=true
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# Off: the box has no mail transport, and with it on, registration silently fails at the
# verification step.
EMAIL_HOST=
