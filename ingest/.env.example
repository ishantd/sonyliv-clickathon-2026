# ClickHouse connection for the ingestion pipeline.
#
#   cp .env.example .env    and fill in your service details.
#
# .env is gitignored. Never commit real credentials.
# Environment variables override anything set here, so CI can inject secrets
# without touching the file.

# --- ClickHouse Cloud (the target for the hackathon) ---------------------
# Host is the service endpoint WITHOUT a protocol or port.
CLICKHOUSE_HOST=your-service.region.provider.clickhouse.cloud
CLICKHOUSE_PORT=9440
CLICKHOUSE_SECURE=true
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# --- Local ClickHouse in Docker (for development) ------------------------
# docker run -d --rm --name sonyliv-ch -p 9000:9000 -p 8123:8123 \
#   -e CLICKHOUSE_PASSWORD=hackathon clickhouse/clickhouse-server:latest
#
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_SECURE=false
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=hackathon
# CLICKHOUSE_DATABASE=default

# --- Client tuning (optional; defaults shown) ----------------------------
# CLICKHOUSE_DIAL_TIMEOUT=30s
# CLICKHOUSE_READ_TIMEOUT=5m
# CLICKHOUSE_MAX_OPEN_CONNS=16
